# Local development only. Replace every secret before using outside your own computer.
POSTGRES_DB=quarry_one
POSTGRES_USER=quarry_one
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
DATABASE_BACKEND=docker
DATABASE_URL=postgresql+psycopg://quarry_one:local-only-change-me@127.0.0.1:5432/quarry_one
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=20
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
COMPANY_NAME=Quarry One
# Required only for the one-time administrator bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
